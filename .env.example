# Copy to .env and fill in. Never commit real values.
APP_ENV=development
APP_URL=http://localhost:3000

# Local Postgres from docker compose. Test DB is used by integration and E2E tests.
DATABASE_URL=postgres://lunak9:lunak9@localhost:5432/lunak9_dev
TEST_DATABASE_URL=postgres://lunak9:lunak9@localhost:5432/lunak9_test

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email: smtp (Mailpit in dev at http://localhost:8025) | file (tests) | console (no email)
EMAIL_TRANSPORT=smtp
EMAIL_FROM="LunaK9 Club <no-reply@lunak9club.test>"
EMAIL_SANDBOX=1
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_DIR=.tmp/mail

# Auth rate limiting (on|off). Keep on except in automated tests.
AUTH_RATE_LIMIT=on

# Log level: fatal|error|warn|info|debug
LOG_LEVEL=info

# Document storage: fs (files on this computer in STORAGE_DIR) | s3 (any S3-compatible store, e.g. Cloudflare R2)
STORAGE_DRIVER=fs
STORAGE_DIR=.data/uploads
# S3_ENDPOINT=
# S3_REGION=eu-west-2
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1

