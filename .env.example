# Copy to .env and fill in. Never commit real values.
APP_ENV=development
APP_URL=http://localhost:3000

# Local Postgres from docker compose. Test DB is used by integration and E2E tests.
DATABASE_URL=postgres://lunak9:lunak9@localhost:5432/lunak9_dev
TEST_DATABASE_URL=postgres://lunak9:lunak9@localhost:5432/lunak9_test
# Required for integration and E2E tests (no built-in fallback). Use a database of your own,
# e.g. lunak9_<you>_test, if several checkouts share one Postgres.

# E2E (Playwright) server. Pick your own port if others run E2E on this machine, because Playwright
# reuses any server already listening on it. Host defaults to 127.0.0.1; E2E_BASE_URL overrides both.
# E2E_PORT=3100
# E2E_HOST=127.0.0.1
# E2E_BASE_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email: smtp (Mailpit in dev at http://localhost:8025) | file (tests) | console (no email)
EMAIL_TRANSPORT=smtp
EMAIL_FROM="Luna's K9 Club <no-reply@lunak9club.test>"
EMAIL_SANDBOX=1
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_DIR=.tmp/mail

# Auth rate limiting (on|off). Keep on except in automated tests.
AUTH_RATE_LIMIT=on

# Log level: fatal|error|warn|info|debug
LOG_LEVEL=info

# Document storage: fs (files on this computer in STORAGE_DIR) | s3 (any S3-compatible store, e.g. Cloudflare R2)
STORAGE_DRIVER=fs
STORAGE_DIR=.data/uploads
# S3_ENDPOINT=
# S3_REGION=eu-west-2
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1

# --- Later phases (names only) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# RESEND_API_KEY=

# Scheduled jobs (invoices on the 25th/28th, reminders, nightly membership booking).
# Set to a long random value to enable POST /api/jobs/tick for an external scheduler. Locally, run `pnpm jobs:tick`.
# CRON_SECRET=

# Card payments. 'simulated' needs no account: a pretend checkout page at /dev/checkout.
# For Stripe test mode: PAYMENTS_DRIVER=stripe, STRIPE_SECRET_KEY=sk_test_…, and for webhooks
# run `stripe listen --forward-to localhost:3000/api/webhooks/stripe` and paste its whsec_… here.
# Live keys (sk_live_) are refused unless APP_ENV=production.
PAYMENTS_DRIVER=simulated
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
